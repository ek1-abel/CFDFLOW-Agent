# CFDFlow-Agent 环境配置

# 主语言模型配置 (必填)
LLM_MODEL_ID=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT=120

# Tavily 搜索工具 API Key (可选)
TAVILY_API_KEY=your-tavily-key-here

# 视觉审稿模型配置 (可选)
VISION_LLM_MODEL_ID=glm-4v-flash
VISION_LLM_BASE_URL=https://open.ai.cn/api/
VISION_LLM_API_KEY=your-vision-key-here
VISION_LLM_TIMEOUT=120
