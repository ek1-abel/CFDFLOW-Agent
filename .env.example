# CFDFlow-Agent 环境配置

# 主语言模型配置 (必填)
LLM_MODEL_ID=your-model-id-here
LLM_BASE_URL=https://open.ai.cn/api/
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT=120

# Tavily 搜索工具 API Key (可选)
TAVILY_API_KEY=your-tavily-key-here

# 视觉审稿模型配置 (可选)
VISION_LLM_MODEL_ID=your-vision-model-id-here
VISION_LLM_BASE_URL=https://open.ai.cn/api/
VISION_LLM_API_KEY=your-vision-key-here
VISION_LLM_TIMEOUT=120
